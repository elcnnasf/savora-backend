PORT=3000
NODE_ENV=development

# Supabase — https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://<your-project-ref>.supabase.co/rest/v1/
SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# JWT (öz tokenlərimiz üçün — istəsəz Supabase-in JWT-ni birbaşa istifadə edə bilərsiniz)
JWT_SECRET=min_32_char_random_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# CORS — frontend origin
ALLOWED_ORIGINS=http://localhost:8081,exp://192.168.1.x:8081

# Gemini AI - https://aistudio.google.com/apikey (free tier: Flash ~250 req/day, Flash-Lite ~1000 req/day)
GEMINI_API_KEY=
